# automation/.env.example
#
# Copy this file to automation/.env and fill in your credentials.
# Never commit the .env file — it contains secrets.
#
#   cp automation/.env.example automation/.env

# ── Devin credentials ──────────────────────────────────────────────────────
# Find these in the Devin web app under Settings → API
DEVIN_API_KEY=your_devin_api_key_here
DEVIN_ORG_ID=your_devin_org_id_here

# ── GitHub credentials ─────────────────────────────────────────────────────
# A personal access token with repo + issues scopes
# https://github.com/settings/tokens/new?scopes=repo,issues
GITHUB_TOKEN=your_github_token_here

# Your fork slug: "username/superset"
GITHUB_REPO=juikhankari/superset
GITHUB_REPOSITORY=juikhankari/superset

# ── Used only by the "remediate" service (local simulation) ───────────────
# In production, these are set automatically by the GitHub Action.
# Fill these in only if you want to test remediation locally without GitHub Actions.
ISSUE_NUMBER=1
ISSUE_TITLE=fix(views): handle malformed datasourceKey in datasource_metadata endpoint
ISSUE_BODY=See the GitHub issue for full details.
ISSUE_URL=https://github.com/juikhankari/superset/issues/1
